# SQL Optima — Docker Compose environment variables
# Copy this file to .env and adjust values before running: docker compose up --build

# ---------- TimescaleDB (metrics store) ----------
DB_USER=dbmonitor
DB_PASSWORD=change_me_in_production_use_strong_password
DB_NAME=dbmonitor_metrics

# ---------- API server ----------
API_PORT=8080

# Auth: enabled by default to match platform compose; replace JWT_SECRET with a strong value before use.
AUTH_REQUIRED=1
JWT_SECRET=change-me-to-32chars-minimum-for-prod

# ---------- Vault (Transit KMS for credential encryption) ----------
# IMPORTANT: The Docker Compose stack uses file-backed Vault storage.
# Keys survive container restarts. The root token is written to the
# vault_data Docker volume at first-run init time.
#
# To retrieve your root token after first run:
#   docker compose exec vault cat /vault/data/.root_token
#
# For production: replace this single-node setup with a proper Vault cluster,
# use AppRole auth (not root tokens), and back up /vault/data regularly.
VAULT_TRANSIT_KEY=sql-optima

# ---------- Monitored server credentials (optional) ----------
# If you prefer config.yaml over the web UI for adding targets, supply
# credentials via env vars using the pattern: DB_<INSTANCE_NAME>_USER / _PASSWORD
# Example:
# DB_SQL_PROD_01_USER=dbmonitor_admin
# DB_SQL_PROD_01_PASSWORD=SuperSecretPassword
# DB_PG_CLUSTER_01_USER=postgres_admin
# DB_PG_CLUSTER_01_PASSWORD=StrongPGPassword

# ---------- Lightweight Query Metrics V2 Pipeline ----------
# Enable the new hash-based delta architecture for SQL Server and PostgreSQL collectors.
# This runs side-by-side with the existing query collector for backward compatibility.
# Enabled by default. Set to false to disable.
ENABLE_QUERY_V2_PIPELINE=true

# ---------- Alert Notifications ----------
# Leave empty to disable. Both are optional and independent.

# Generic HTTP webhook — receives JSON with event_type, title, severity, server_name, etc.
# Example: ALERT_WEBHOOK_URL=https://hooks.example.com/sql-optima
ALERT_WEBHOOK_URL=

# Slack Incoming Webhook URL (from https://api.slack.com/messaging/webhooks)
# Example: SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/xxxx
SLACK_WEBHOOK_URL=

# ---------- Cold Storage (MinIO / S3) ----------
# Enable the cold storage export pipeline
COLD_STORAGE_ENABLED=false

# S3-compatible endpoint — use http://minio:9000 for self-hosted MinIO
# Leave empty or set to "" to use AWS S3 (will use standard AWS resolver)
COLD_STORAGE_ENDPOINT=http://minio:9000

# Target bucket — must already exist (or minio-init service will create it)
COLD_STORAGE_BUCKET=sql-optima-cold

# AWS/MinIO region
COLD_STORAGE_REGION=us-east-1

# Credentials
COLD_STORAGE_ACCESS_KEY_ID=sqloptima
COLD_STORAGE_SECRET_ACCESS_KEY=change_me_in_production

# Use path-style URLs (required for MinIO, set to false for AWS S3)
COLD_STORAGE_FORCE_PATH_STYLE=true

# Prefix inside the bucket
COLD_STORAGE_PREFIX=metrics/

# How many days behind today the export cutoff sits (ensures chunks are compressed)
COLD_STORAGE_LAG_DAYS=2

# Rows per batch read from TimescaleDB
COLD_STORAGE_BATCH_SIZE=50000

# Local temp dir for staging Parquet files before upload
COLD_STORAGE_STAGING_DIR=/tmp/sql-optima-cold-staging

# Iceberg REST catalog URL (Phase 2 — leave empty for Phase 1)
COLD_STORAGE_CATALOG_URL=

# MinIO console and API ports (used by Docker Compose)
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Nessie and Trino ports
NESSIE_PORT=19120
TRINO_PORT=8081
