# Stage 1: Build the Go Backend
# Build context: repo root (sql_monitoring_UI/).
FROM golang:1.25.7 AS builder

WORKDIR /build/backend
COPY backend/go.mod backend/go.sum ./
RUN go mod download
COPY backend/ ./
# Refresh embedded OS collector assets from repo root (build context).
COPY os_collector/sql-optima-os-collector.sh ./internal/oscollectorbundle/assets/sql-optima-os-collector.sh
COPY os_collector/systemd/sql-optima-os-collector.service.example ./internal/oscollectorbundle/assets/systemd/sql-optima-os-collector.service
# config.yaml is optional — instances come from server registry in Docker mode.
RUN echo 'instances: []' > ../config.yaml
COPY frontend/ ../frontend/

RUN CGO_ENABLED=0 GOOS=linux go build -o /dbmonitor ./cmd/server

# Stage 2: Minimal Runtime
FROM gcr.io/distroless/static-debian12:nonroot
WORKDIR /srv

COPY --from=builder /build/config.yaml ./
COPY --from=builder /build/frontend/ ./frontend/
COPY --from=builder /dbmonitor ./backend/dbmonitor

WORKDIR /srv/backend
USER nonroot:nonroot
EXPOSE 8080

CMD ["./dbmonitor"]
