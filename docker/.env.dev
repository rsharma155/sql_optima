# SQL Optima - Docker Compose dev defaults (easy / safe profile)
# Copied or regenerated by start-dev.sh on first run.
# Do NOT use outside trusted networks. For production, use .env.example.

# ---------- TimescaleDB (metrics store) ----------
DB_USER=dbmonitor
DB_PASSWORD=sql_optima_dev_local_only
DB_NAME=dbmonitor_metrics

# ---------- API server ----------
API_PORT=8080

AUTH_REQUIRED=1
DISABLE_PUBLIC_SETUP=0
JWT_SECRET=sql-optima-local-dev-jwt-secret-32chars-min

# ---------- Vault (Transit KMS) ----------
VAULT_TRANSIT_KEY=sql-optima

# ---------- Cold storage (optional - off for quick start) ----------
COLD_STORAGE_ENABLED=false
COLD_STORAGE_SECRET_ACCESS_KEY=sql_optima_dev_local_only

# Easy setup: no COMPOSE_FILE dev overlay (TimescaleDB not published to LAN).
SQL_OPTIMA_SETUP_MODE=easy
SQL_OPTIMA_EXPOSE_DB_LAN=0
